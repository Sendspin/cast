{
  "name": "sendspin-over-cast",
  "version": "0.1.0",
  "type": "module",
  "description": "Chromecast receiver for Music Assistant using the Sendspin protocol",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "prettier:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@sendspin/sendspin-js": "2.0.5"
  },
  "devDependencies": {
    "@types/chromecast-caf-receiver": "^6.0.25",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.57.1",
    "eslint": "10.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "^8.0.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  }
}
